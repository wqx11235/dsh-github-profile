{
  "name": "dsh-github-profile",
  "version": "0.1.3",
  "type": "module",
  "description": "GitHub 档案页：资料卡、仓库卡与贡献热力图，数据只读公开信息，多源降级不怕主站抖动",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
